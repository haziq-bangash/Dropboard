{
  "name": "@dropboard/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --exclude \"./src/generated/**\" --env-file-if-exists=../../.env.local src/index.ts",
    "build": "prisma generate && tsup",
    "start": "node dist/index.js",
    "typecheck": "prisma generate && tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.98",
    "@ai-sdk/google": "4.0.113",
    "@ai-sdk/google-vertex": "5.0.133",
    "@ai-sdk/openai": "4.0.111",
    "@ai-sdk/xai": "5.0.40",
    "@dropboard/engine": "workspace:^",
    "@dropboard/spec": "workspace:*",
    "@hono/node-server": "^1.13.0",
    "@hono/zod-validator": "^0.9.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "ai": "7.0.164",
    "better-auth": "^1.7.18",
    "hono": "^4.6.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "prisma": "7.10.1",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
