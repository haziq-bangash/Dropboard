generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---- Better Auth core tables ----

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions   Session[]
  accounts   Account[]
  dashboards Dashboard[]
  subscription Subscription?

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---- Dropboard ----

model Dashboard {
  id         String   @id @default(cuid())
  ownerId    String
  owner      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title      String
  // Where the data came from, shown so people know which file to re-attach. Rows are never stored here.
  sourceName String?
  rowCount   Int?
  // DashboardSpec (see packages/spec). Validated with zod before write.
  spec       Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  shares Share[]

  @@index([ownerId, updatedAt])
  @@map("dashboard")
}

// A published, read-only snapshot: the spec plus precomputed chart results. No raw rows.
model Share {
  id           String    @id @default(cuid())
  slug         String    @unique
  dashboardId  String
  dashboard    Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  passwordHash String?
  spec         Json
  // Precomputed results keyed by chart id
  results      Json
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?
  // After this the link shows "expired" (a paid plan's link control). Null means it does not expire.
  expiresAt    DateTime?
  // How many times the link was opened by someone with access (a paid plan's link control).
  views        Int       @default(0)

  @@index([dashboardId])
  @@map("share")
}

// ---- AI ----

// Cache of generated dashboards, keyed by a hash of model + prompt version + schema + instruction.
model AiCache {
  key       String   @id
  spec      Json
  createdAt DateTime @default(now())

  @@map("ai_cache")
}

// One row per AI call. Quota counts uncached rows; Phase 4 billing reads the token columns.
model AiGeneration {
  id              String   @id @default(cuid())
  userId          String
  kind            String
  cached          Boolean
  model           String
  inputTokens     Int      @default(0)
  outputTokens    Int      @default(0)
  cacheReadTokens Int      @default(0)
  createdAt       DateTime @default(now())

  @@index([userId, createdAt])
  @@map("ai_generation")
}

// ---- Billing ----

// One row per person who has been through checkout. The plan is what the limits are read from; Stripe is the source of truth and
// the webhook keeps this in step with it.
model Subscription {
  userId               String    @id
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId     String    @unique
  stripeSubscriptionId String?   @unique
  // "pro" or "team". A person who is not paying has no row, or a canceled one.
  plan                 String
  // Stripe's own status: active, trialing, past_due, canceled, unpaid, incomplete...
  status               String
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  updatedAt            DateTime  @updatedAt

  @@map("subscription")
}

// Stripe sends an event more than once now and then. Each id is recorded with the work it caused, so a repeat does nothing.
model StripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())

  @@map("stripe_event")
}
