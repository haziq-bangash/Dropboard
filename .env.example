# Copy to .env.local at the repo root (gitignored). `pnpm dev` loads it for the API.
DATABASE_URL=postgres://dropboard:dropboard@localhost:5432/dropboard
BETTER_AUTH_SECRET=change-me-to-a-random-string-of-32-plus-chars
BETTER_AUTH_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:3000
PORT=8787
# Optional: enables the AI routes
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-5-5
# AI_DAILY_LIMIT=10

# The web app reads API_URL from apps/web/.env.local:
#   API_URL=http://localhost:8787
