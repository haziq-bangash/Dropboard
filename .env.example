# Copy to .env.local at the repo root (gitignored). `pnpm dev` loads it for the API.
DATABASE_URL=postgres://dropboard:dropboard@localhost:5432/dropboard
BETTER_AUTH_SECRET=change-me-to-a-random-string-of-32-plus-chars
BETTER_AUTH_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:3000
PORT=8787
# Pilot (the AI assistant) is provider-agnostic, built on the Vercel AI SDK. Pick one:
#   AI_PROVIDER=google      Gemini on Google Cloud Vertex AI (default model gemini-3.5-flash-lite)
#   AI_PROVIDER=anthropic   Claude (default model claude-haiku-5-5), needs ANTHROPIC_API_KEY
#   AI_PROVIDER=none        switch AI off
# With nothing set, AI is on if ANTHROPIC_API_KEY or GOOGLE_API_KEY is present, otherwise off (routes answer 503).
# AI_MODEL=gemini-3.5-flash-lite
# AI_DAILY_LIMIT=10
#
# google, on Cloud Run: no key at all. The service runs as an account with the "Vertex AI User" role
# (infra/setup-runtime-sa.sh) and needs the project to bill:
# GOOGLE_CLOUD_PROJECT=your-project-id
# AI_GOOGLE_LOCATION=global
# google, anywhere else: either run `gcloud auth application-default login`, or set a Vertex express-mode key.
# The key must be allowed to call the Vertex AI API (Google Cloud console > Credentials > API restrictions):
# GOOGLE_API_KEY=
# AI_GOOGLE_BACKEND=vertex          vertex (default) or gemini-api (Google AI Studio keys)
# ANTHROPIC_API_KEY=
# Google sign-in (optional). Redirect URI: <web origin>/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# The web app reads API_URL from apps/web/.env.local:
#   API_URL=http://localhost:8787
